<Window x:Class="SalaryManager.App.AddEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <Style x:Key="SegmentRadio" TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignRadioButton}">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <!-- Name + Base Salary row -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="EMPLOYEE NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         TabIndex="0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="BASE SALARY (₹)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding BaseSalary, UpdateSourceTrigger=PropertyChanged}"
                         TabIndex="1"/>
            </StackPanel>
        </Grid>

        <!-- Joining Date -->
        <StackPanel Grid.Row="4">
            <TextBlock Text="JOINING DATE" Style="{StaticResource FieldLabel}"/>
            <DatePicker SelectedDate="{Binding JoiningDate, Mode=TwoWay}"
                        TabIndex="2"/>
        </StackPanel>

        <!-- Active + Payment Mode label -->
        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <CheckBox Content="Active"
                      IsChecked="{Binding IsActive}"
                      VerticalAlignment="Center"
                      Margin="0,0,22,0"/>
            <TextBlock Text="PAYMENT MODE" Style="{StaticResource FieldLabel}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Segmented selector -->
        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <RadioButton Style="{StaticResource SegmentRadio}"
                         Content="Cash"
                         IsChecked="{Binding IsCash, Mode=TwoWay}"
                         TabIndex="3"/>
            <RadioButton Style="{StaticResource SegmentRadio}"
                         Content="ICICI Bank"
                         IsChecked="{Binding IsIcici, Mode=TwoWay}"
                         Margin="8,0,0,0" TabIndex="4"/>
            <RadioButton Style="{StaticResource SegmentRadio}"
                         Content="Other Bank"
                         IsChecked="{Binding IsOther, Mode=TwoWay}"
                         Margin="8,0,0,0" TabIndex="5"/>
        </StackPanel>

        <!-- Bank fields — hidden when Cash is selected -->
        <Grid Grid.Row="9"
              Visibility="{Binding ShowBankFields, Converter={StaticResource BoolToVis}}"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="ACCOUNT NO" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                         TabIndex="6"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="IFSC CODE" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding IfscCode, UpdateSourceTrigger=PropertyChanged}"
                         TabIndex="7"/>
            </StackPanel>
        </Grid>

        <!-- Groups -->
        <StackPanel Grid.Row="11">
            <TextBlock Text="GROUPS" Style="{StaticResource FieldLabel}"/>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="6" MaxHeight="120" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}"
                                          IsChecked="{Binding IsSelected}"
                                          Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Row="12" Height="1" Background="{StaticResource BorderBrush}"
                VerticalAlignment="Bottom" Margin="0,0,0,4"/>

        <!-- Action buttons -->
        <Grid Grid.Row="13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                    Content="Cancel" Click="Cancel_Click" TabIndex="9"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                    Content="{Binding SaveButtonText}" Click="Add_Click"
                    IsDefault="True" TabIndex="8"/>
        </Grid>
    </Grid>
</Window>
