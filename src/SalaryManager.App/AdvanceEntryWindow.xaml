<Window x:Class="SalaryManager.App.AdvanceEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Advance Entry"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit advance entry"
                   FontSize="18" FontWeight="SemiBold"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="DATE" Style="{StaticResource FieldLabel}"/>
                <DatePicker SelectedDate="{Binding Date}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="TYPE" Style="{StaticResource FieldLabel}"/>
                <ComboBox ItemsSource="{Binding EntryTypes}"
                          SelectedItem="{Binding EntryType}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4">
            <TextBlock Text="AMOUNT (₹)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="NARRATION" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}"
                    Content="Cancel" Click="Cancel_Click"/>
            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                    Content="Save" Click="Save_Click" IsDefault="True"/>
        </Grid>
    </Grid>
</Window>
