<Window x:Class="SalaryManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SalaryManager.App.Views"
        xmlns:vm="clr-namespace:SalaryManager.App.ViewModels"
        Title="Salary Manager" Height="720" Width="1180"
        MinWidth="960" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Lazy view materialization: WPF only constructs each view when the
             matching tab is first selected, not at MainWindow.InitializeComponent. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalarySheetViewModel}">
            <v:SalarySheetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancesViewModel}">
            <v:AdvancesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <v:ReportsView/>
        </DataTemplate>

        <!-- Tab item: sits in the dark strip, blue underline when selected -->
        <Style x:Key="AppTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header "Employees" button (white text, sits on the dark bar) -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl: dark strip with tabs left + Employees button right, content fills below -->
        <Style x:Key="AppTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Dark header bar: tabs on left, Employees on right -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource SidebarBrush}"
                                    BorderBrush="#1E293B"
                                    BorderThickness="0,0,0,1"
                                    ClipToBounds="True">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource HeaderButton}"
                                            Content="Employees"
                                            VerticalAlignment="Center"
                                            Margin="0,0,16,0"
                                            Command="{Binding DataContext.OpenEmployeesCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TabPanel IsItemsHost="True"
                                              Background="Transparent"/>
                                </DockPanel>
                            </Border>
                            <!-- Content fills remaining space -->
                            <ContentPresenter Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Single TabControl fills the whole window -->
    <TabControl Style="{StaticResource AppTabControl}"
                KeyboardNavigation.TabNavigation="Cycle">
        <TabItem Style="{StaticResource AppTabItem}" Content="{Binding DashboardVm}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"
                          Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M3,13 L9,7 L13,11 L21,3 M21,3 L15,3 M21,3 L21,9 M3,21 L21,21"/>
                    <AccessText Text="Dashboard"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem Style="{StaticResource AppTabItem}" Content="{Binding SalarySheetVm}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"
                          Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,4 L19,4 Q21,4,21,6 L21,18 Q21,20,19,20 L5,20 Q3,20,3,18 L3,6 Q3,4,5,4 Z M3,10 L21,10 M9,4 L9,20"/>
                    <AccessText Text="Salary Sheet"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem Style="{StaticResource AppTabItem}" Content="{Binding AdvancesVm}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"
                          Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M2,8 L22,8 M2,8 L2,17 A2,2,0,0,0,4,19 L20,19 A2,2,0,0,0,22,17 L22,8 M2,8 L5,4 L19,4 L22,8"/>
                    <AccessText Text="Advances"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>
        <TabItem Style="{StaticResource AppTabItem}" Content="{Binding ReportsVm}">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,7,0"
                          Stroke="#94A3B8" StrokeThickness="1.5" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M4,19 L4,5 M4,19 L20,19 M8,15 L8,9 M12,15 L12,7 M16,15 L16,11"/>
                    <AccessText Text="Reports"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>
    </TabControl>
</Window>
