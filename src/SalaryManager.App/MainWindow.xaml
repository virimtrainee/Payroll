<Window x:Class="SalaryManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:v="clr-namespace:SalaryManager.App.Views"
        xmlns:vm="clr-namespace:SalaryManager.App.ViewModels"
        Title="Salary Manager"
        Height="820" Width="1360"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalarySheetViewModel}">
            <v:SalarySheetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancesViewModel}">
            <v:AdvancesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <v:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <v:EmployeesView/>
        </DataTemplate>

        <LinearGradientBrush x:Key="ShellSidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#07162C" Offset="0"/>
            <GradientStop Color="#082A5A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ShellTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource ShellSidebarBrush}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Top" Padding="14,20,14,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="7"
                                                    Background="{StaticResource PrimaryBrush}"
                                                    BorderBrush="#80BFFF" BorderThickness="1">
                                                <TextBlock Text="SM"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="Salary Manager"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="12,0,0,0"
                                                       Visibility="{Binding DataContext.SidebarTextVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Command="{Binding DataContext.ToggleSidebarCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="8,0,0,0"
                                                    ToolTip="Collapse sidebar"
                                                    Foreground="#D6E4F7"
                                                    Background="#173966"
                                                    BorderBrush="#2E5C96"
                                                    BorderThickness="1"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    HorizontalContentAlignment="Center"
                                                    VerticalContentAlignment="Center"
                                                    Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4">
                                                            <TextBlock Text="&lt;"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       FontSize="{TemplateBinding FontSize}"
                                                                       FontWeight="{TemplateBinding FontWeight}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Border DockPanel.Dock="Top"
                                            Height="1"
                                            Background="#18345F"
                                            Margin="0,0,0,14"/>

                                    <TabPanel IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Background="Transparent"
                                              Margin="12,0,12,0"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{StaticResource BackgroundBrush}">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#D6E4F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#183D72"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs"
                Style="{StaticResource ShellTabControl}"
                SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                KeyboardNavigation.TabNavigation="Cycle">
        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding DashboardVm}" ToolTip="Dashboard">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <materialDesign:PackIcon Kind="ViewDashboardOutline"
                                             Width="18"
                                             Height="18"
                                             Margin="{Binding SidebarIconMargin}"
                                             Foreground="#D6E4F7"/>
                    <AccessText Text="Dashboard" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding SalarySheetVm}" ToolTip="Salary Sheet">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <materialDesign:PackIcon Kind="TableLarge"
                                             Width="18"
                                             Height="18"
                                             Margin="{Binding SidebarIconMargin}"
                                             Foreground="#D6E4F7"/>
                    <AccessText Text="Salary Sheet" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding AdvancesVm}" ToolTip="Advances">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <materialDesign:PackIcon Kind="CashMultiple"
                                             Width="18"
                                             Height="18"
                                             Margin="{Binding SidebarIconMargin}"
                                             Foreground="#D6E4F7"/>
                    <AccessText Text="Advances" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding ReportsVm}" ToolTip="Reports">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <materialDesign:PackIcon Kind="FileChartOutline"
                                             Width="18"
                                             Height="18"
                                             Margin="{Binding SidebarIconMargin}"
                                             Foreground="#D6E4F7"/>
                    <AccessText Text="Reports" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding EmployeesVm}" ToolTip="Employees">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <materialDesign:PackIcon Kind="AccountGroupOutline"
                                             Width="18"
                                             Height="18"
                                             Margin="{Binding SidebarIconMargin}"
                                             Foreground="#D6E4F7"/>
                    <AccessText Text="Employees" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>
    </TabControl>
</Window>
