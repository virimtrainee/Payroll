<Window x:Class="SalaryManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:SalaryManager.App.Views"
        xmlns:vm="clr-namespace:SalaryManager.App.ViewModels"
        Title="Salary Manager"
        Height="820" Width="1360"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <v:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalarySheetViewModel}">
            <v:SalarySheetView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancesViewModel}">
            <v:AdvancesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <v:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <v:EmployeesView/>
        </DataTemplate>

        <LinearGradientBrush x:Key="ShellSidebarBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#07162C" Offset="0"/>
            <GradientStop Color="#082A5A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="ShellTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="TabStripPlacement" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DataContext.SidebarWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource ShellSidebarBrush}">
                                <DockPanel LastChildFill="True">
                                    <Border DockPanel.Dock="Top" Padding="14,20,14,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="7"
                                                    Background="{StaticResource PrimaryBrush}"
                                                    BorderBrush="#80BFFF" BorderThickness="1">
                                                <TextBlock Text="SM"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="Salary Manager"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Margin="12,0,0,0"
                                                       Visibility="{Binding DataContext.SidebarTextVisibility, RelativeSource={RelativeSource TemplatedParent}}"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="2"
                                                    Content="{Binding DataContext.SidebarToggleGlyph, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Command="{Binding DataContext.ToggleSidebarCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="8,0,0,0"
                                                    ToolTip="Collapse sidebar"
                                                    Foreground="#D6E4F7"
                                                    Background="#173966"
                                                    BorderBrush="#2E5C96"
                                                    BorderThickness="1"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Cursor="Hand"/>
                                        </Grid>
                                    </Border>

                                    <Border DockPanel.Dock="Top"
                                            Height="1"
                                            Background="#18345F"
                                            Margin="0,0,0,14"/>

                                    <TabPanel IsItemsHost="True"
                                              KeyboardNavigation.TabIndex="1"
                                              Background="Transparent"
                                              Margin="12,0,12,0"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="{StaticResource BackgroundBrush}">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#D6E4F7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#183D72"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="MainTabs"
                Style="{StaticResource ShellTabControl}"
                SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}"
                KeyboardNavigation.TabNavigation="Cycle">
        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding DashboardVm}" ToolTip="Dashboard">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <Path Width="18" Height="18" Stretch="Uniform" Margin="{Binding SidebarIconMargin}"
                          Stroke="#D6E4F7" StrokeThickness="1.8" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z"/>
                    <AccessText Text="Dashboard" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding SalarySheetVm}" ToolTip="Salary Sheet">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <Path Width="18" Height="18" Stretch="Uniform" Margin="{Binding SidebarIconMargin}"
                          Stroke="#D6E4F7" StrokeThickness="1.8" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M5,4 L19,4 Q21,4,21,6 L21,18 Q21,20,19,20 L5,20 Q3,20,3,18 L3,6 Q3,4,5,4 Z M3,10 L21,10 M8,4 L8,20"/>
                    <AccessText Text="Salary Sheet" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding AdvancesVm}" ToolTip="Advances">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <Path Width="18" Height="18" Stretch="Uniform" Margin="{Binding SidebarIconMargin}"
                          Stroke="#D6E4F7" StrokeThickness="1.8" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M3,7 L21,7 M4,7 L4,18 Q4,20,6,20 L18,20 Q20,20,20,18 L20,7 M7,7 L8,4 L16,4 L17,7 M8,13 L16,13"/>
                    <AccessText Text="Advances" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding ReportsVm}" ToolTip="Reports">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <Path Width="18" Height="18" Stretch="Uniform" Margin="{Binding SidebarIconMargin}"
                          Stroke="#D6E4F7" StrokeThickness="1.8" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M4,20 L20,20 M6,18 L6,10 M11,18 L11,5 M16,18 L16,13"/>
                    <AccessText Text="Reports" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>

        <TabItem Style="{StaticResource SidebarNavItem}" Content="{Binding EmployeesVm}" ToolTip="Employees">
            <TabItem.Header>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="{Binding SidebarItemAlignment}">
                    <Path Width="18" Height="18" Stretch="Uniform" Margin="{Binding SidebarIconMargin}"
                          Stroke="#D6E4F7" StrokeThickness="1.8" Fill="Transparent"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M16,19 L16,17 Q16,15,14,15 L8,15 Q6,15,6,17 L6,19 M11,11 Q14,11,14,8 Q14,5,11,5 Q8,5,8,8 Q8,11,11,11 Z M20,19 L20,17 Q20,15,18,15 M17,11 Q19,11,19,9 Q19,7,17,7"/>
                    <AccessText Text="Employees" Visibility="{Binding SidebarTextVisibility}"/>
                </StackPanel>
            </TabItem.Header>
        </TabItem>
    </TabControl>
</Window>
