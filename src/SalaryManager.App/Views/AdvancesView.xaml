<UserControl x:Class="SalaryManager.App.Views.AdvancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundBrush}">
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <Grid Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Advances"
                       Style="{StaticResource PageTitle}"
                       Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Employees" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Border CornerRadius="6" Background="#EEF2FF" BorderBrush="#C7D2FE" BorderThickness="1" Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FilteredCount}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Search employees..."
                                         Margin="0,0,0,10"/>
                                <CheckBox Content="With balance only"
                                          IsChecked="{Binding ShowOnlyWithAdvances}"
                                          Foreground="{StaticResource MutedTextBrush}"
                                          Margin="0,0,0,10"/>
                                <ComboBox ItemsSource="{Binding GroupFilterOptions}"
                                          SelectedItem="{Binding SelectedGroupFilter}"
                                          DisplayMemberPath="Name"/>
                            </StackPanel>
                        </Border>

                        <StackPanel DockPanel.Dock="Top" VerticalAlignment="Top" Margin="18,28,18,18">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No matching employees"/>
                            <TextBlock Style="{StaticResource EmptyStateSubtitle}" Text="Adjust the search, group, or balance filter."/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding EmployeeRailView}"
                                 SelectedItem="{Binding SelectedRailItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Padding="10"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="8"
                                                        Padding="12,10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#93C5FD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="8"
                                                Background="{StaticResource PrimaryBrush}"
                                                Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       Foreground="White"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding BaseSalary, StringFormat={}Base ₹{0:N0}}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Balance, StringFormat={}₹{0:N2}}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Balance}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="64" Height="64" CornerRadius="8"
                                    Background="{StaticResource PrimaryBrush}"
                                    Margin="0,0,20,0">
                                <TextBlock Text="{Binding SelectedEmployeeInitials}"
                                           Foreground="White"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedEmployee.Name, TargetNullValue='Select an employee'}"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <StackPanel Margin="0,0,36,0">
                                        <TextBlock Text="Base Salary" Style="{StaticResource FieldLabel}"/>
                                        <TextBlock Text="{Binding SelectedEmployee.BaseSalary, StringFormat={}₹{0:N0}}"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Payment Mode" Style="{StaticResource FieldLabel}"/>
                                        <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedEmployee.PaymentMode}" Value="Cash">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SelectedEmployee.PaymentMode}" Value="IciciBank">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                            <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Other Bank"/>
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedEmployee.PaymentMode}" Value="Cash">
                                                                <Setter Property="Text" Value="Cash"/>
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedEmployee.PaymentMode}" Value="IciciBank">
                                                                <Setter Property="Text" Value="ICICI Bank"/>
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1,0,0,0"
                                    Padding="28,0,0,0">
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Outstanding Balance"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding CurrentBalance, StringFormat={}₹{0:N2}}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Add Advance Entry"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Entry Type" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding EntryTypes}"
                                              SelectedItem="{Binding NewEntryType}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="Amount ₹" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="AmountBox"
                                             Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"
                                             PreviewKeyDown="AmountBox_PreviewKeyDown"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                                    <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding NewDate}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="16,0,0,0">
                                    <TextBlock Text="Narration" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="NarrationBox"
                                             Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Enter narration (optional)"
                                             PreviewKeyDown="NarrationBox_PreviewKeyDown"/>
                                </StackPanel>
                                <Button Grid.Column="5"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Post Entry"
                                        VerticalAlignment="Bottom"
                                        Padding="24,10"
                                        Command="{Binding AddEntryCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Advance Ledger"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="20,18,20,14"/>

                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ledger.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="86" Height="86" CornerRadius="8" Background="#EEF2FF" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,16">
                                        <TextBlock Text="□" Foreground="#94A3B8" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Style="{StaticResource EmptyStateTitle}"
                                               Text="No advance ledger entries yet"
                                               FontSize="17"/>
                                    <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                                               Text="This employee does not have any advance entries."
                                               FontSize="13"/>
                                    <Button Content="Post first advance"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,18,0,0"
                                            Command="{Binding AddEntryCommand}"/>
                                </StackPanel>

                                <DataGrid ItemsSource="{Binding Ledger}"
                                          IsReadOnly="True"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.Style>
                                        <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Ledger.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Style>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date"
                                                            Binding="{Binding Entry.Date, StringFormat=dd MMM yyyy}"
                                                            Width="130"/>
                                        <DataGridTemplateColumn Header="Entry Type" Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#FFEDD5"/>
                                                                <Setter Property="BorderBrush" Value="#FED7AA"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Entry.EntryType}" Value="Deducted">
                                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                                        <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Entry.EntryType}" FontSize="12" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#EA580C"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Entry.EntryType}" Value="Deducted">
                                                                            <Setter Property="Foreground" Value="#166534"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Narration" Binding="{Binding Entry.Note}" Width="*"/>
                                        <DataGridTextColumn Header="Amount ₹" Binding="{Binding Entry.Amount, StringFormat=N2}" Width="140">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Balance ₹" Binding="{Binding RunningBalance, StringFormat=N2}" Width="140">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Posted By" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="System" Foreground="{StaticResource MutedTextBrush}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="" Width="82" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Edit"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="10,4"
                                                            Margin="4,2"
                                                            Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
