<UserControl x:Class="SalaryManager.App.Views.AdvancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Advances" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0">
                <Run Text="Pick an employee, enter amount &amp; optional narration."/>
                <Run Text="Enter" FontWeight="SemiBold"/>
                <Run Text="to post — balance updates live."/>
            </TextBlock>
        </StackPanel>

        <!-- Two-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ Left rail: employee list with balances ══ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <!-- Rail header -->
                    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <!-- Title row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Employees" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border CornerRadius="99" Background="#F1F5F9" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilteredCount}"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </Border>
                            </StackPanel>
                            <!-- Search box -->
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search employees…"
                                     Margin="0,0,0,6">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Style.Resources>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- With-advances toggle -->
                            <CheckBox Content="Show only with advances"
                                      Foreground="{StaticResource MutedTextBrush}"
                                      FontSize="11"
                                      IsChecked="{Binding ShowOnlyWithAdvances}"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty rail state (no employees match filter) -->
                    <StackPanel DockPanel.Dock="Top" VerticalAlignment="Top" Margin="14,28,14,14">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource EmptyStateTitle}"
                                   Text="No matches"/>
                        <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                                   Text="Adjust the search or uncheck 'Show only with advances'."/>
                    </StackPanel>

                    <!-- Employee items -->
                    <ListBox DockPanel.Dock="Bottom"
                             ItemsSource="{Binding EmployeeRailView}"
                             SelectedItem="{Binding SelectedRailItem}"
                             BorderThickness="0" Background="Transparent"
                             Padding="6,6,6,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="7"
                                                    Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#BFDBFE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Initials}"
                                                   Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Name + base -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding BaseSalary, StringFormat={}Base ₹{0:N0}}"
                                                   FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,1,0,0"/>
                                    </StackPanel>
                                    <!-- Balance -->
                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                               Text="{Binding Balance, StringFormat={}₹{0:N0}}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Balance, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ══ Right side ══ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Hero + entry form card -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <!-- Employee hero row -->
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Big avatar -->
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                    Background="{StaticResource PrimaryBrush}" Margin="0,0,14,0">
                                <TextBlock Text="{Binding SelectedEmployeeInitials}"
                                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <!-- Name + base -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedEmployee.Name}"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0">
                                    <Run Text="Base"/>
                                    <Run Text="{Binding SelectedEmployee.BaseSalary, StringFormat={}₹{0:N0}}" FontWeight="Medium"/>
                                </TextBlock>
                            </StackPanel>
                            <!-- Outstanding balance card -->
                            <Border Grid.Column="2" CornerRadius="8" Padding="14,6"
                                    BorderThickness="1" BorderBrush="#BFDBFE">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#EFF6FF" Offset="0"/>
                                        <GradientStop Color="#FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="OUTSTANDING" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentBalance, StringFormat={}₹{0:N2}}"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Entry form -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="AMOUNT (₹)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="AmountBox"
                                         Text="{Binding NewAmount, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="AmountBox_PreviewKeyDown"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                <TextBlock Text="NARRATION" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="NarrationBox"
                                         Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewKeyDown="NarrationBox_PreviewKeyDown"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                    Content="Post entry" VerticalAlignment="Bottom"
                                    Command="{Binding AddEntryCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Ledger -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Margin="20,40">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Ledger.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Style="{StaticResource EmptyStateTitle}"
                                       Text="No ledger entries"/>
                            <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                                       Text="Use the form above to record an advance. Postings from the Salary Sheet show up here too."/>
                        </StackPanel>

                    <DataGrid ItemsSource="{Binding Ledger}" IsReadOnly="True">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Ledger.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Entry.Date, StringFormat=yyyy-MM-dd}"
                                                Width="120"/>

                            <!-- Type badge column -->
                            <DataGridTemplateColumn Header="Type" Width="120" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="99" Padding="8,3" HorizontalAlignment="Left" Margin="2,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Entry.EntryType}" Value="Deducted">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="↗ Given"/>
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Entry.EntryType}" Value="Deducted">
                                                                <Setter Property="Text" Value="↙ Deducted"/>
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Amount"
                                                Binding="{Binding Entry.Amount, StringFormat={}₹{0:N2}}"
                                                Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Narration"
                                                Binding="{Binding Entry.Note}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Balance"
                                                Binding="{Binding RunningBalance, StringFormat={}₹{0:N2}}"
                                                Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
