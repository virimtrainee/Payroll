<UserControl x:Class="SalaryManager.App.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Attendance" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0">
                <Run Text="Enter attendance data per employee. "/>
                <Run Text="{Binding DaysInMonth, StringFormat={}{0} days in this month., Mode=OneWay}"/>
                <Run Text="  Tab: next cell · Enter: next row · F2: edit cell"/>
            </TextBlock>
        </StackPanel>

        <!-- Controls bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="MONTH" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Months}"
                              SelectedItem="{Binding SelectedMonth}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="YEAR" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Years}"
                              SelectedItem="{Binding SelectedYear}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="GROUP" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Width="160" ItemsSource="{Binding GroupFilterOptions}"
                              SelectedItem="{Binding SelectedGroupFilter}"
                              DisplayMemberPath="Name"/>
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}"
                        Content="Reload" Margin="8,18,8,0"
                        Command="{Binding LoadCommand}"/>
                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}"
                        Content="Save Attendance" Margin="0,18,0,0"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>

        <!-- Editable attendance table -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="AttendanceGrid"
                      ItemsSource="{Binding Rows}"
                      SelectionUnit="Cell"
                      SelectionMode="Single"
                      CurrentCellChanged="AttendanceGrid_CurrentCellChanged">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="Employee"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True"
                                        Width="*"
                                        MinWidth="140">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Base Salary"
                                        Binding="{Binding BaseSalary, StringFormat=N2}"
                                        IsReadOnly="True"
                                        Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Days Absent"
                                        Binding="{Binding DaysAbsent, UpdateSourceTrigger=PropertyChanged}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4,0"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <!-- ESIC: formatted display, raw edit -->
                    <DataGridTemplateColumn Header="ESIC Deduction" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EsicDeduction, StringFormat=N2}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="0,0,12,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding EsicDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsesEsicPf}"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- PF: formatted display, raw edit -->
                    <DataGridTemplateColumn Header="PF Deduction" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PfDeduction, StringFormat=N2}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="0,0,12,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding PfDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsesEsicPf}"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- TDS: formatted display, raw edit -->
                    <DataGridTemplateColumn Header="TDS Deduction" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TdsDeduction, StringFormat=N2}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="0,0,12,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding TdsDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsesTds}"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0"
                                         Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
