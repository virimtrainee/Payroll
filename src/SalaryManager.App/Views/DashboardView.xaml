<UserControl x:Class="SalaryManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashboardCardTitle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="DashboardNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="SmallStatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Dashboard"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,22"/>

                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,20">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#DBEAFE">
                                <TextBlock Text="₹" Foreground="{StaticResource PrimaryBrush}" FontSize="20"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PAYABLE" Style="{StaticResource DashboardCardTitle}"/>
                                <TextBlock Text="{Binding PayablePayroll, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=0}"
                                           Style="{StaticResource DashboardNumber}"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Net payroll"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#FFEDD5">
                                <TextBlock Text="₹" Foreground="#EA580C" FontSize="20"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ADVANCES" Style="{StaticResource DashboardCardTitle}"/>
                                <TextBlock Text="{Binding OutstandingAdvances, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=0}"
                                           Style="{StaticResource DashboardNumber}"
                                           Foreground="#EA580C"/>
                                <TextBlock Text="{Binding EmployeesWithPendingAdvances, StringFormat={}{0} pending}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#DCFCE7">
                                <TextBlock Text="✓" Foreground="#16A34A" FontSize="20"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ATTENDANCE" Style="{StaticResource DashboardCardTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding AttendanceSavedThisMonth}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#16A34A"/>
                                    <TextBlock Text=" / "
                                               FontSize="24"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding ActiveEmployees}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock Text="This month"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#F3E8FF">
                                <TextBlock Text="↗" Foreground="#7C3AED" FontSize="20"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CHANGES" Style="{StaticResource DashboardCardTitle}"/>
                                <TextBlock Text="{Binding SalaryChangesCount}"
                                           Style="{StaticResource DashboardNumber}"
                                           Foreground="#7C3AED"/>
                                <TextBlock Text="{Binding SalaryReviewStatusText}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <DockPanel LastChildFill="False">
                            <Grid DockPanel.Dock="Top" Margin="20,18,20,12">
                                <TextBlock Text="Advance Entries" FontSize="15" FontWeight="Bold"/>
                                <Button Content="All"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.ShowAdvancesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <DataGrid DockPanel.Dock="Top"
                                      ItemsSource="{Binding RecentAdvances}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Emp" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTemplateColumn Header="Type" Width="76">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="1" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding EntryType}" Foreground="#EA580C" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=0}" Width="96">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Dt" Binding="{Binding Date, StringFormat=dd/MM}" Width="64"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                                <Grid>
                                    <TextBlock Text="Total Advances" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding OutstandingAdvances, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=0}"
                                               HorizontalAlignment="Right"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#EA580C"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel LastChildFill="False">
                            <Grid DockPanel.Dock="Top" Margin="20,18,20,12">
                                <TextBlock Text="Salary Changes" FontSize="15" FontWeight="Bold"/>
                                <Button Content="All"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.ShowEmployeesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <DataGrid DockPanel.Dock="Top"
                                      ItemsSource="{Binding RecentRevisions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Emp" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTextColumn Header="Old" Binding="{Binding OldSalary, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain0}" Width="76"/>
                                    <DataGridTextColumn Header="New" Binding="{Binding NewSalary, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain0}" Width="76">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Dt" Binding="{Binding ChangedAt, StringFormat=dd/MM}" Width="64"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                                <Grid>
                                    <TextBlock Text="Total Increases" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalRevisionIncrease, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=0}"
                                               HorizontalAlignment="Right"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#16A34A"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,24,0,0"
                        CornerRadius="8"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        Background="#EFF6FF"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="i" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PayrollBannerTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0B2A5B"/>
                            <TextBlock Text="{Binding PayrollBannerSubtitle}"
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="Go to Reports"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding DataContext.ShowReportsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Padding="22,10"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
