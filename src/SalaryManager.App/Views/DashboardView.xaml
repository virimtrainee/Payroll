<UserControl x:Class="SalaryManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashboardCardTitle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="DashboardNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="SmallStatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="99"/>
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,28,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Dashboard"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,22"/>

                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,24">
                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="8" Background="#DBEAFE">
                                <TextBlock Text="₹" Foreground="{StaticResource PrimaryBrush}" FontSize="28"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="TOTAL PAYABLE" Style="{StaticResource DashboardCardTitle}"/>
                                <TextBlock Text="{Binding GrossPayroll, StringFormat={}₹{0:N0}}"
                                           Style="{StaticResource DashboardNumber}"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding GrossPayroll, StringFormat={}Gross ₹{0:N0} • Deductions ₹0}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="8" Background="#FFEDD5">
                                <TextBlock Text="₹" Foreground="#EA580C" FontSize="28"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="OUTSTANDING ADVANCES" Style="{StaticResource DashboardCardTitle}"/>
                                <TextBlock Text="{Binding OutstandingAdvances, StringFormat={}₹{0:N0}}"
                                           Style="{StaticResource DashboardNumber}"
                                           Foreground="#EA580C"/>
                                <TextBlock Text="{Binding EmployeesWithPendingAdvances, StringFormat={}{0} employees with pending advances}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="8" Background="#DCFCE7">
                                <TextBlock Text="✓" Foreground="#16A34A" FontSize="24"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ATTENDANCE ENTERED" Style="{StaticResource DashboardCardTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding AttendanceSavedThisMonth}"
                                               FontSize="28"
                                               FontWeight="Bold"
                                               Foreground="#16A34A"/>
                                    <TextBlock Text=" / "
                                               FontSize="24"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding ActiveEmployees}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock Text="Employees • This Month"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="8" Background="#F3E8FF">
                                <TextBlock Text="↗" Foreground="#7C3AED" FontSize="24"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SALARY CHANGES" Style="{StaticResource DashboardCardTitle}"/>
                                <TextBlock Text="{Binding SalaryChangesCount}"
                                           Style="{StaticResource DashboardNumber}"
                                           Foreground="#7C3AED"/>
                                <TextBlock Text="Changes pending review"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPeriod, StringFormat={}Payroll Checklist - {0}}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Margin="0,0,0,16"/>

                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <Grid Height="58" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="✓" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Attendance Entry" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}">
                                                <Run Text="{Binding AttendanceSavedThisMonth}"/><Run Text=" of "/><Run Text="{Binding ActiveEmployees}"/><Run Text=" employees"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SmallStatusBadge}" Background="#DCFCE7">
                                            <TextBlock Text="Completed" Foreground="#166534" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="24" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}"/>

                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="↗" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Salary Review" FontWeight="SemiBold"/>
                                            <TextBlock Text="Review salary changes" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SmallStatusBadge}" Background="#DCFCE7">
                                            <TextBlock Text="Completed" Foreground="#166534" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="24" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}"/>

                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#FFF7ED" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="₹" Foreground="#EA580C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Advances &amp; Deductions" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding OutstandingAdvances, StringFormat={}{0:N0} outstanding}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SmallStatusBadge}" Background="#FFEDD5">
                                            <TextBlock Text="Pending" Foreground="#EA580C" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="24" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}"/>

                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#F1F5F9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="□" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Salary Sheet Finalization" FontWeight="SemiBold"/>
                                            <TextBlock Text="Generate payroll" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SmallStatusBadge}" Background="#F1F5F9">
                                            <TextBlock Text="Not Started" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="24" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Separator Background="{StaticResource BorderBrush}"/>

                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" Background="#F1F5F9" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="□" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Payslip Generation" FontWeight="SemiBold"/>
                                            <TextBlock Text="Create &amp; distribute payslips" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource SmallStatusBadge}" Background="#F1F5F9">
                                            <TextBlock Text="Not Started" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="›" Foreground="{StaticResource MutedTextBrush}" FontSize="24" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="20,18,20,12">
                                <TextBlock Text="Recent Advance Entries" FontSize="17" FontWeight="Bold"/>
                                <Button Content="View All"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.ShowAdvancesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding RecentAdvances}"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTemplateColumn Header="Type" Width="82">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Background="#FFEDD5" BorderBrush="#FED7AA" BorderThickness="1" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding EntryType}" Foreground="#EA580C" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat={}₹{0:N0}}" Width="95">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd MMM yyyy}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                                <Grid>
                                    <TextBlock Text="Total Advances" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding OutstandingAdvances, StringFormat={}₹{0:N0}}"
                                               HorizontalAlignment="Right"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#EA580C"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="20,18,20,12">
                                <TextBlock Text="Recent Salary Changes" FontSize="17" FontWeight="Bold"/>
                                <Button Content="View All"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding DataContext.ShowEmployeesCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Grid>
                            <DataGrid ItemsSource="{Binding RecentRevisions}"
                                      IsReadOnly="True"
                                      BorderThickness="0"
                                      RowHeight="42">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="*"/>
                                    <DataGridTextColumn Header="Old (₹)" Binding="{Binding OldSalary, StringFormat=N0}" Width="92"/>
                                    <DataGridTextColumn Header="New (₹)" Binding="{Binding NewSalary, StringFormat=N0}" Width="92">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Date" Binding="{Binding ChangedAt, StringFormat=dd MMM yyyy}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,16">
                                <Grid>
                                    <TextBlock Text="Total Increases" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding TotalRevisionIncrease, StringFormat={}₹{0:N0}}"
                                               HorizontalAlignment="Right"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#16A34A"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3"
                        Margin="0,24,0,0"
                        CornerRadius="8"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        Background="#EFF6FF"
                        Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="i" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="You’re all set! Attendance is complete and payroll is ready."
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0B2A5B"/>
                            <TextBlock Text="Review salary changes and generate payroll when ready."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="Go to Reports"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding DataContext.ShowReportsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Padding="22,10"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
