<UserControl x:Class="SalaryManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                    Content="Refresh" Command="{Binding LoadCommand}"/>
            <StackPanel>
                <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
            </StackPanel>
        </DockPanel>

        <!-- Stat cards -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,16">

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EFF6FF" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="ACTIVE EMPLOYEES" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding ActiveEmployees}" FontSize="34" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0">
                        <Run Text="{Binding TotalEmployees}"/>
                        <Run Text="total registered"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F0FDF4" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="GROSS PAYROLL" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding GrossPayroll, StringFormat='₹{0:N0}'}"
                               FontSize="34" FontWeight="Bold" Foreground="#16A34A" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF7ED" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="OUTSTANDING ADVANCES" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding OutstandingAdvances, StringFormat='₹{0:N0}'}"
                               FontSize="34" FontWeight="Bold" Foreground="#EA580C" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FAF5FF" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="ATTENDANCE SAVED" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AttendanceSavedThisMonth}" FontSize="34"
                                   FontWeight="Bold" Foreground="#7C3AED"/>
                        <TextBlock Text=" / " FontSize="22" Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ActiveEmployees}" FontSize="22"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Two-column activity section -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent Advances -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Recent Advances" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Empty state -->
                    <StackPanel DockPanel.Dock="Bottom"
                                VerticalAlignment="Top" Margin="20,32,20,20">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentAdvances.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource EmptyStateTitle}"
                                   Text="No advances yet"/>
                        <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                                   Text="Given/deducted entries will appear here as you record them on the Advances tab."/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding RecentAdvances}"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentAdvances.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee"
                                                Binding="{Binding EmployeeName}" Width="*"/>

                            <DataGridTemplateColumn Header="Type" Width="90" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="99" Padding="7,2"
                                                HorizontalAlignment="Left" Margin="4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF3C7"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EntryType}" Value="Deducted">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="↗ Given"/>
                                                        <Setter Property="Foreground" Value="#92400E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EntryType}" Value="Deducted">
                                                                <Setter Property="Text" Value="↙ Deducted"/>
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Amount"
                                                Binding="{Binding Amount, StringFormat='₹{0:N0}'}"
                                                Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding Date, StringFormat=yyyy-MM-dd}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Salary Revisions -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,12"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Salary Revisions" FontSize="13" FontWeight="SemiBold"/>
                    </Border>

                    <!-- Empty state -->
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="No salary revisions recorded yet. Changes will appear here when you edit and save base salaries."
                               FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap" Margin="20,20" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentRevisions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid ItemsSource="{Binding RecentRevisions}"
                              IsReadOnly="True" AutoGenerateColumns="False"
                              BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RecentRevisions.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee"
                                                Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="Old (₹)"
                                                Binding="{Binding OldSalary, StringFormat=N0}"
                                                Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="New (₹)"
                                                Binding="{Binding NewSalary, StringFormat=N0}"
                                                Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#16A34A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding ChangedAt, StringFormat=yyyy-MM-dd}"
                                                Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Backup / Restore bar -->
        <Border Grid.Row="3" Style="{StaticResource FilterBar}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DATABASE BACKUP" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Backup Now"
                        Margin="0,0,8,0" Command="{Binding BackupDatabaseCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Restore from Backup"
                        Command="{Binding RestoreDatabaseCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</UserControl>
