<UserControl x:Class="SalaryManager.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Reports" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Generate payroll summaries and per-employee advance ledgers."
                       Style="{StaticResource PageSubtitle}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- KPI strip: 4 cards -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,14">

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EFF6FF" Offset="0"/>
                        <GradientStop Color="#FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock Text="TOTAL PAYABLE" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding KpiTotalPayable}"
                               FontSize="22" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="This period" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="GROSS" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding KpiGross}"
                               FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Sum of base salaries" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="DEDUCTIONS" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding KpiDeductions}"
                               FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Absent + ESIC + PF" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ACTIVE EMPLOYEES" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding KpiActiveEmployees}"
                               FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="On payroll" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Report cards row -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Monthly payroll summary -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Title row -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="#EFF6FF" Margin="0,0,12,0">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,4 L19,4 Q21,4,21,6 L21,18 Q21,20,19,20 L5,20 Q3,20,3,18 L3,6 Q3,4,5,4 Z M3,10 L21,10 M9,4 L9,20"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Monthly payroll summary" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="One row per employee — base, deductions, advances, net pay."
                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Period selectors -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PERIOD" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Months}"
                                  SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Name"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Years}"
                                  SelectedItem="{Binding SelectedYear}" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Action footer -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Export as" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="PDF"
                                    Margin="0,0,8,0" Command="{Binding SummaryPdfCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Excel"
                                    Margin="0,0,8,0" Command="{Binding SummaryExcelCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="CSV"
                                    Command="{Binding SummaryCsvCommand}"/>
                        </StackPanel>
                    </Border>

                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Advance ledger -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- Title row -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="36" Height="36" CornerRadius="8"
                                Background="#FEF3C7" Margin="0,0,12,0">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                                  Stroke="#D97706" StrokeThickness="1.5"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M16,21 L16,19 A4,4,0,0,0,12,15 L6,15 A4,4,0,0,0,2,19 L2,21 M9,11 A4,4,0,1,0,9,3 A4,4,0,0,0,9,11 Z M22,11 L16,11 M19,8 L19,14"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Advance ledger" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Text="Full give/deduct history with running balance per employee."
                                       FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Employee selector -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="EMPLOYEE" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Employees}"
                                  SelectedItem="{Binding SelectedEmployee}"
                                  DisplayMemberPath="Name"/>
                    </Grid>

                    <!-- Action footer -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Export as" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="PDF"
                                    Margin="0,0,8,0" Command="{Binding LedgerPdfCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Excel"
                                    Command="{Binding LedgerExcelCommand}"/>
                        </StackPanel>
                    </Border>

                    <Grid/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
