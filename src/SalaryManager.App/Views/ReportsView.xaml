<UserControl x:Class="SalaryManager.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ReportCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="ReportMetricLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="ReportMetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,18,28,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Reports"
                           Style="{StaticResource PageTitle}"
                           Margin="0,0,0,14"/>

                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#DBEAFE">
                                <TextBlock Text="₹" Foreground="{StaticResource PrimaryBrush}" FontSize="20" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PAYABLE" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding KpiTotalPayable}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0"/>
                                <TextBlock Text="Net payroll" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#DCFCE7">
                                <TextBlock Text="▥" Foreground="#16A34A" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GROSS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding KpiGross}" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="Gross payroll" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#FFEDD5">
                                <TextBlock Text="%" Foreground="#EA580C" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DEDUCTIONS" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding KpiDeductions}" FontSize="20" FontWeight="Bold" Margin="0,6,0,0"/>
                                <TextBlock Text="Total deductions" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="#F3E8FF">
                                <TextBlock Text="U" Foreground="#7C3AED" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="EMPLOYEES" Style="{StaticResource FieldLabel}"/>
                                <TextBlock Text="{Binding KpiActiveEmployees}" FontSize="20" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,0"/>
                                <TextBlock Text="On payroll" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="8" Background="#DBEAFE">
                            <TextBlock Text="₹" Foreground="{StaticResource PrimaryBrush}" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Grid Grid.Column="1" Margin="14,0,18,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Salary Slip" Style="{StaticResource ReportCardTitle}"/>
                                <TextBlock Text="Select an employee and generate the salary slip for the selected period."
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Months}"
                                          SelectedItem="{Binding SelectedMonth}"
                                          DisplayMemberPath="Name"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding Years}"
                                          SelectedItem="{Binding SelectedYear}"
                                          Margin="10,0,0,0"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding GroupFilterOptions}"
                                          SelectedItem="{Binding SelectedGroupFilter}"
                                          DisplayMemberPath="Name"
                                          Margin="10,0,0,0"/>
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding Employees}"
                                          SelectedItem="{Binding SelectedEmployee}"
                                          DisplayMemberPath="Name"
                                          Margin="10,0,0,0"/>
                            </Grid>
                        </Grid>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="PDF"
                                    Padding="12,7"
                                    Margin="0,0,8,0"
                                    Command="{Binding SalarySlipPdfCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Print"
                                    Padding="14,7"
                                    Command="{Binding SalarySlipPrintCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="42" Height="42" CornerRadius="8" Background="#DBEAFE" Margin="0,0,16,0">
                                    <TextBlock Text="▦" Foreground="{StaticResource PrimaryBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Monthly Payroll Summary" Style="{StaticResource ReportCardTitle}"/>
                                    <TextBlock Text="Get a summary of payroll for the selected period." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="0"/>
                                    <ColumnDefinition Width="0"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Name"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Margin="10,0,0,0"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding GroupFilterOptions}" SelectedItem="{Binding SelectedGroupFilter}" DisplayMemberPath="Name" Margin="10,0,0,0"/>
                            </Grid>

                            <Grid DockPanel.Dock="Top" Margin="0,2,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="NET" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding KpiTotalPayable}" Style="{StaticResource ReportMetricValue}" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="EMPLOYEES" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding KpiActiveEmployees}" Style="{StaticResource ReportMetricValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DEDUCTIONS" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding KpiDeductions}" Style="{StaticResource ReportMetricValue}"/>
                                </StackPanel>
                            </Grid>

                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Export as:" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="PDF" Padding="10,7" Margin="0,0,6,0" Command="{Binding SummaryPdfCommand}"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Excel" Padding="10,7" Margin="0,0,6,0" Command="{Binding SummaryExcelCommand}"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="CSV" Padding="10,7" Margin="0,0,6,0" Command="{Binding SummaryCsvCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="View" Padding="10,7" Command="{Binding SummaryPdfCommand}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="42" Height="42" CornerRadius="8" Background="#DCFCE7" Margin="0,0,16,0">
                                    <TextBlock Text="▣" Foreground="#16A34A" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Bank / ICICI Export" Style="{StaticResource ReportCardTitle}"/>
                                    <TextBlock Text="Generate ICICI bank upload file for salary payments." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid DockPanel.Dock="Top" Margin="0,2,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="PAYABLE" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding KpiTotalPayable}" Style="{StaticResource ReportMetricValue}" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="EMPLOYEES" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding KpiActiveEmployees}" Style="{StaticResource ReportMetricValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="FORMAT" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="ICICI" Style="{StaticResource ReportMetricValue}" FontSize="16"/>
                                </StackPanel>
                            </Grid>

                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Export as:" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="PDF" Command="{Binding SummaryPdfCommand}"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Background="#16A34A"
                                            Content="Generate Excel"
                                            HorizontalAlignment="Right"
                                            Command="{Binding IciciExcelCommand}"/>
                                </Grid>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="42" Height="42" CornerRadius="8" Background="#FFEDD5" Margin="0,0,16,0">
                                    <TextBlock Text="₹" Foreground="#EA580C" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Advance Ledger Report" Style="{StaticResource ReportCardTitle}"/>
                                    <TextBlock Text="View advance entries for employees or groups." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding GroupFilterOptions}" SelectedItem="{Binding SelectedGroupFilter}" DisplayMemberPath="Name"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" DisplayMemberPath="Name" Margin="12,0,0,0"/>
                            </Grid>

                            <Grid DockPanel.Dock="Top" Margin="0,2,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GROUP" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding SelectedGroupFilter.Name, TargetNullValue='All Groups'}" Style="{StaticResource ReportMetricValue}" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="EMPLOYEES" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding KpiActiveEmployees}" Style="{StaticResource ReportMetricValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ADVANCES" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding KpiTotalAdvances}" Style="{StaticResource ReportMetricValue}" Foreground="#EA580C"/>
                                </StackPanel>
                            </Grid>

                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Export as:" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="PDF" Padding="10,7" Margin="0,0,6,0" Command="{Binding LedgerPdfCommand}"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Excel" Padding="10,7" Margin="0,0,6,0" Command="{Binding LedgerExcelCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="View" Padding="10,7" Command="{Binding LedgerPdfCommand}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="42" Height="42" CornerRadius="8" Background="#F3E8FF" Margin="0,0,16,0">
                                    <TextBlock Text="↗" Foreground="#7C3AED" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Salary Revisions Report" Style="{StaticResource ReportCardTitle}"/>
                                    <TextBlock Text="View employee salary revisions and history." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid DockPanel.Dock="Top" Margin="0,2,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="REVISIONS" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding RevisionEntryCount}" Style="{StaticResource ReportMetricValue}" Foreground="#7C3AED"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="EMPLOYEES" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding RevisionEmployeeCount}" Style="{StaticResource ReportMetricValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="UPDATED" Style="{StaticResource ReportMetricLabel}"/>
                                    <TextBlock Text="{Binding LastRevisionDate}" Style="{StaticResource ReportMetricValue}" FontSize="16"/>
                                </StackPanel>
                            </Grid>

                            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Export as:" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="PDF" Padding="10,7" Margin="0,0,6,0" Command="{Binding RevisionPdfCommand}"/>
                                    <Button Style="{StaticResource SecondaryButton}" Content="Excel" Padding="10,7" Margin="0,0,6,0" Command="{Binding RevisionExcelCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="View" Padding="10,7" Command="{Binding RevisionPdfCommand}"/>
                                </StackPanel>
                            </Border>
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="4"
                        Margin="0,14,0,0"
                        CornerRadius="8"
                        Background="#EEF6FF"
                        Padding="18">
                    <TextBlock Text="All reports are generated based on the latest payroll and employee data."
                               Foreground="#395B89"
                               FontSize="14"/>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
