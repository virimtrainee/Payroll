<UserControl x:Class="SalaryManager.App.Views.SalarySheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Grid>
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
    <Grid Margin="20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Salary Sheet" Style="{StaticResource PageTitle}"/>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,4,0,0">
                <Run Text="Press"/>
                <Run Text="Edit" FontWeight="SemiBold"/>
                <Run Text="to unlock the sheet. Absent · ESIC · PF · TDS · Adv. Deduction update Net Salary live. Enter moves between columns, Ctrl+S saves."/>
            </TextBlock>
        </StackPanel>

        <!-- Single-row filter bar -->
        <Border Grid.Row="1" Style="{StaticResource FilterBar}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="PERIOD" Style="{StaticResource FieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="132" ItemsSource="{Binding Months}"
                          SelectedItem="{Binding SelectedMonth}" DisplayMemberPath="Name"/>
                <ComboBox Width="76" ItemsSource="{Binding Years}"
                          SelectedItem="{Binding SelectedYear}" Margin="8,0,0,0"/>

                <ComboBox Width="150" ItemsSource="{Binding GroupFilterOptions}"
                          SelectedItem="{Binding SelectedGroupFilter}"
                          DisplayMemberPath="Name" Margin="8,0,0,0"/>

                <Separator Style="{StaticResource VSep}"/>

                <!-- Edit / Done toggle -->
                <Button Margin="0,0,8,0" Command="{Binding ToggleEditModeCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Editing — click to lock"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="False">
                                    <Setter Property="Content" Value="Edit sheet"/>
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Style="{StaticResource SecondaryButton}" Content="Reload"
                        Margin="0,0,8,0" Command="{Binding LoadCommand}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Save"
                        IsEnabled="{Binding IsEditMode}"
                        Command="{Binding SaveAttendanceCommand}"/>

                <Separator Style="{StaticResource VSep}"/>

                <Button Style="{StaticResource SecondaryButton}" Content="Cash PDF"
                        Margin="0,0,8,0" Command="{Binding ExportCashPdfCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="All PDF"
                        Margin="0,0,8,0" Command="{Binding ExportSummaryPdfCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Export Excel"
                        Margin="0,0,8,0" Command="{Binding ExportToExcelCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="ICICI Excel"
                        Margin="0,0,8,0" Command="{Binding ExportIciciExcelCommand}"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Post Advances"
                        Command="{Binding PostDeductionsCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="20,40">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource EmptyStateTitle}"
                               Text="No active employees for this period"/>
                    <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                               Text="Add employees from the Employees window, or pick a different month/year above."/>
                </StackPanel>

            <DataGrid x:Name="SalaryGrid"
                      ItemsSource="{Binding Rows}"
                      IsReadOnly="{Binding IsGridReadOnly}"
                      SelectionUnit="Cell"
                      SelectionMode="Single"
                      CurrentCellChanged="SalaryGrid_CurrentCellChanged"
                      PreviewKeyDown="SalaryGrid_PreviewKeyDown">
                <DataGrid.Style>
                    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>

                    <DataGridTextColumn Header="S.No."
                                        Binding="{Binding SerialNumber}"
                                        IsReadOnly="True" Width="44">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Read-only identification -->
                    <DataGridTextColumn Header="Employee"
                                        Binding="{Binding Name}"
                                        IsReadOnly="True" Width="*" MinWidth="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Base"
                                        Binding="{Binding BaseSalary, StringFormat=N2}"
                                        IsReadOnly="True" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Editable: Absent -->
                    <DataGridTemplateColumn Header="Absent" Width="68"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DaysAbsent}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding DaysAbsent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Padding="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Editable: ESIC -->
                    <DataGridTemplateColumn Header="ESIC" Width="85"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding EsicDeduction, StringFormat=N2}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="0,0,10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding EsicDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsesEsicPf}"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Editable: PF -->
                    <DataGridTemplateColumn Header="PF" Width="80"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PfDeduction, StringFormat=N2}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="0,0,10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding PfDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsesEsicPf}"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Editable: TDS -->
                    <DataGridTemplateColumn Header="TDS" Width="85"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TdsDeduction, StringFormat=N2}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="0,0,10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding TdsDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding UsesTds}"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Editable: Adv. Deduct -->
                    <DataGridTemplateColumn Header="Adv. Ded" Width="90"
                                            CellStyle="{StaticResource EditableCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AdvanceDeductionEntry, StringFormat=N2}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Padding="0,0,10,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding AdvanceDeductionEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         BorderThickness="0" Padding="8,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Computed read-only -->
                    <DataGridTextColumn Header="Per-Day"
                                        Binding="{Binding PerDay, StringFormat=N2}"
                                        IsReadOnly="True" Width="82">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Deduction"
                                        Binding="{Binding Deduction, StringFormat=N2}"
                                        IsReadOnly="True" Width="88">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Adv. Bal"
                                        Binding="{Binding AdvanceBalance, StringFormat=N2}"
                                        IsReadOnly="True" Width="82">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Net Salary"
                                        Binding="{Binding NetSalary, StringFormat=N2}"
                                        IsReadOnly="True" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Slip" Width="82" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="PDF"
                                        Style="{StaticResource SecondaryButton}"
                                        Padding="10,3" Margin="5,2"
                                        Command="{Binding DataContext.GenerateSlipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        </Border>

        <!-- Total payable bar — gradient + breakdown -->
        <Border Grid.Row="3" CornerRadius="10" Margin="0,8,0,0" Padding="18,0" Height="56" BorderThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#3B82F6" Offset="0.6"/>
                    <GradientStop Color="#60A5FA" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#1D4ED8" Opacity="0.28" BlurRadius="20" ShadowDepth="6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: label + breakdown -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL PAYABLE" Foreground="#DBEAFE"
                               FontSize="11" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Foreground="#BFDBFE" FontSize="12">
                            <Run Text="Gross "/>
                            <Run Text="{Binding TotalGross, StringFormat={}₹{0:N0}}"
                                 Foreground="White" FontWeight="SemiBold"/>
                            <Run Text="  ·  Deductions " Foreground="#BFDBFE"/>
                            <Run Text="{Binding TotalDeduction, StringFormat={}₹{0:N0}}"
                                 Foreground="White" FontWeight="SemiBold"/>
                            <Run Text="  ·  " Foreground="#BFDBFE"/>
                            <Run Text="{Binding EmployeeCount}" Foreground="White" FontWeight="SemiBold"/>
                            <Run Text=" employees" Foreground="#BFDBFE"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Right: big amount -->
                <TextBlock Grid.Column="2"
                           Text="{Binding TotalNet, StringFormat={}₹{0:N2}}"
                           Foreground="White" FontSize="24" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
