<UserControl x:Class="SalaryManager.App.Views.SalarySheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SalaryManager.App.Helpers"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
        <Style x:Key="InlineLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="RightCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GroupChipCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="bd"
                                CornerRadius="8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Background="White"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AllChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ResizableSalaryColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="SizeWE"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <Grid Margin="18,12,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Salary Sheet"
                       Style="{StaticResource PageTitle}"
                       FontSize="24"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Month" Style="{StaticResource InlineLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="112"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Months}"
                                          Style="{StaticResource PayrollModernComboBox}"
                                          materialDesign:HintAssist.Hint="Month"
                                          SelectedItem="{Binding SelectedMonth}"
                                          DisplayMemberPath="Name"/>
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource PayrollModernComboBox}"
                                          materialDesign:HintAssist.Hint="Year"
                                          ItemsSource="{Binding Years}"
                                          SelectedItem="{Binding SelectedYear}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Group" Style="{StaticResource InlineLabel}"/>
                            <ComboBox ItemsSource="{Binding GroupDropdownOptions}"
                                      Style="{StaticResource PayrollModernComboBox}"
                                      materialDesign:HintAssist.Hint="Group"
                                      SelectedItem="{Binding SelectedGroupDropdownFilter}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Search Employee" Style="{StaticResource InlineLabel}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search by name..."/>
                        </StackPanel>

                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Margin="0,0,10,0"
                                    Command="{Binding ToggleEditModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Content" Value="Edit Sheet"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Content" Value="Lock Sheet"/>
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Save"
                                    IsEnabled="{Binding IsEditMode}"
                                    Margin="0,0,10,0"
                                    Command="{Binding SaveAttendanceCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Reload"
                                    Margin="0,0,10,0"
                                    Command="{Binding LoadCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Add Employee"
                                    Command="{Binding DataContext.EmployeesVm.OpenAddEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Group"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ScrollViewer Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All"
                                        Command="{Binding ClearGroupFiltersCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AllChipButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllGroupsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ItemsControl ItemsSource="{Binding GroupFilterOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Style="{StaticResource GroupChipCheckBox}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Export"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Cash PDF"
                                    Margin="0,0,8,0" Padding="12,7" Command="{Binding ExportCashPdfCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="All PDF"
                                    Margin="0,0,8,0" Padding="12,7" Command="{Binding ExportSummaryPdfCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="ICICI Excel"
                                    Margin="0,0,8,0" Padding="12,7" Command="{Binding ExportIciciExcelCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Excel"
                                    Margin="0,0,8,0" Padding="12,7" Command="{Binding ExportToExcelCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Post Advances"
                                    Padding="12,7"
                                    Command="{Binding PostDeductionsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource EmptyStateTitle}"
                                   Text="No active employees for this period"/>
                        <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                                   Text="Add employees from the Employees page, or pick a different month/group."/>
                    </StackPanel>

                    <DataGrid x:Name="SalaryGrid"
                              ItemsSource="{Binding RowsView}"
                              IsReadOnly="{Binding IsGridReadOnly}"
                              RowHeight="44"
                              CanUserResizeColumns="True"
                              ColumnHeaderStyle="{StaticResource ResizableSalaryColumnHeader}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionUnit="Cell"
                              SelectionMode="Single"
                              CurrentCellChanged="SalaryGrid_CurrentCellChanged"
                              PreviewKeyDown="SalaryGrid_PreviewKeyDown">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <StackPanel>
                                                        <Border Background="#F8FAFC"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="12,9">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}"/>
                                                                <TextBlock HorizontalAlignment="Right"
                                                                           Text="{Binding Converter={StaticResource SalaryGroupSummaryConverter}}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="S.No."
                                                helpers:DataGridColumnKey.Key="serial"
                                                Binding="{Binding SerialNumber}"
                                                IsReadOnly="True"
                                                Width="62">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Employee" helpers:DataGridColumnKey.Key="employee" Width="*" MinWidth="190" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1"
                                                      Content="Override"
                                                      IsChecked="{Binding IsNetSalaryOverrideEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Foreground="{StaticResource MutedTextBrush}"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Group"
                                                helpers:DataGridColumnKey.Key="group"
                                                Binding="{Binding GroupDisplayName}"
                                                IsReadOnly="True"
                                                Width="120"/>

                            <DataGridTemplateColumn Header="Payment" helpers:DataGridColumnKey.Key="payment" Width="100" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12,4" HorizontalAlignment="Left" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="Cash">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="IciciBank">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                            <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PaymentModeLabel}" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaymentMode}" Value="Cash">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PaymentMode}" Value="IciciBank">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Base Salary (₹)"
                                                helpers:DataGridColumnKey.Key="baseSalary"
                                                Binding="{Binding BaseSalary, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="126"
                                                ElementStyle="{StaticResource RightCellText}"/>

                            <DataGridTemplateColumn Header="Absent" helpers:DataGridColumnKey.Key="absent" Width="78"
                                                    CellStyle="{StaticResource EditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysAbsent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DaysAbsent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ESIC (₹)" helpers:DataGridColumnKey.Key="esic" Width="96"
                                                    CellStyle="{StaticResource EditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EsicDeduction, StringFormat=N2}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding EsicDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UsesEsicPf}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="PF (₹)" helpers:DataGridColumnKey.Key="pf" Width="92"
                                                    CellStyle="{StaticResource EditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PfDeduction, StringFormat=N2}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PfDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UsesEsicPf}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TDS (₹)" helpers:DataGridColumnKey.Key="tds" Width="96"
                                                    CellStyle="{StaticResource EditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TdsDeduction, StringFormat=N2}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TdsDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UsesTds}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Deductions (₹)"
                                                helpers:DataGridColumnKey.Key="deductions"
                                                Binding="{Binding TotalDeductions, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="126"
                                                ElementStyle="{StaticResource RightCellText}"/>

                            <DataGridTemplateColumn Header="Adv. Ded. (₹)" helpers:DataGridColumnKey.Key="advanceDeduction" Width="116"
                                                    CellStyle="{StaticResource EditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AdvanceDeductionEntry, StringFormat=N2}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AdvanceDeductionEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Adv. Balance (₹)"
                                                helpers:DataGridColumnKey.Key="advanceBalance"
                                                Binding="{Binding AdvanceBalance, StringFormat=N2}"
                                                IsReadOnly="True"
                                                Width="132">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightCellText}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#EA580C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdvanceBalance}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Net Salary (₹)" helpers:DataGridColumnKey.Key="netSalary" Width="128"
                                                    CellStyle="{StaticResource EditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NetSalary, StringFormat=N2}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding NetSalaryOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsNetSalaryOverrideEnabled}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Slip" helpers:DataGridColumnKey.Key="slip" Width="82" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="PDF"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="12,4"
                                                Margin="5,2"
                                                Command="{Binding DataContext.GenerateSlipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,12,0,0"
                    CornerRadius="8"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    Background="White"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="18,10">
                        <TextBlock Text="Gross Pay" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalGross, StringFormat={}₹{0:N2}}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="18,10">
                        <TextBlock Text="Deductions" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAbsenceDeduction, StringFormat={}₹{0:N2}}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="18,10">
                        <TextBlock Text="Adv. Deducted" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAdvanceDeduction, StringFormat={}₹{0:N2}}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="18,10">
                        <TextBlock Text="Advance Balance" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAdvanceBalance, StringFormat={}₹{0:N2}}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="4"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="0,8,8,0"
                            Padding="22,10">
                        <StackPanel>
                            <TextBlock Text="Net Payable" Foreground="#DBEAFE" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalNet, StringFormat={}₹{0:N2}}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
