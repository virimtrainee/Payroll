<UserControl x:Class="SalaryManager.App.Views.SalarySheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SalaryManager.App.Helpers"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
        <Style x:Key="InlineLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="LeftCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CenterCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightCellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="GroupChipCheckBox" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
        <Style x:Key="AllChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="ResizableSalaryColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="SizeWE"/>
        </Style>
        <Style x:Key="SalaryHeaderLeft" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResizableSalaryColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="SalaryHeaderCenter" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResizableSalaryColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SalaryHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource ResizableSalaryColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
        <Style x:Key="SalaryReadOnlyCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="SalaryEditableCell" TargetType="DataGridCell" BasedOn="{StaticResource EditableCell}">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ProgressBar Style="{StaticResource LoadingBar}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <Grid Margin="18,12,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Salary Sheet"
                       Style="{StaticResource PageTitle}"
                       FontSize="24"
                       Margin="0,0,0,8"/>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Month" Style="{StaticResource InlineLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Months}"
                                          Style="{StaticResource PayrollModernComboBox}"
                                          materialDesign:HintAssist.Hint="Month"
                                          SelectedItem="{Binding SelectedMonth}"
                                          DisplayMemberPath="Name"/>
                                <ComboBox Grid.Column="2"
                                          Style="{StaticResource PayrollModernComboBox}"
                                          materialDesign:HintAssist.Hint="Year"
                                          ItemsSource="{Binding Years}"
                                          SelectedItem="{Binding SelectedYear}"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Group" Style="{StaticResource InlineLabel}"/>
                            <ComboBox ItemsSource="{Binding GroupDropdownOptions}"
                                      Style="{StaticResource PayrollModernComboBox}"
                                      materialDesign:HintAssist.Hint="Group"
                                      SelectedItem="{Binding SelectedGroupDropdownFilter}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Search Employee" Style="{StaticResource InlineLabel}"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Search by name..."/>
                        </StackPanel>

                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom">
                            <Button Margin="0,0,6,0"
                                    Padding="10,7"
                                    Command="{Binding ToggleEditModeCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                        <Setter Property="Content" Value="Edit"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="Content" Value="Lock"/>
                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Save"
                                    IsEnabled="{Binding IsEditMode}"
                                    Padding="10,7"
                                    Margin="0,0,6,0"
                                    Command="{Binding SaveAttendanceCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}"
                                    Content="Load"
                                    Padding="10,7"
                                    Margin="0,0,6,0"
                                    Command="{Binding LoadCommand}"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Content="Emp"
                                    Visibility="Collapsed"
                                    Padding="10,7"
                                    Command="{Binding DataContext.EmployeesVm.OpenAddEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Group"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <ScrollViewer Grid.Column="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All"
                                        Command="{Binding ClearGroupFiltersCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AllChipButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllGroupsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#EFF6FF"/>
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <ItemsControl ItemsSource="{Binding GroupFilterOptions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Style="{StaticResource GroupChipCheckBox}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Export"
                                       Style="{StaticResource FieldLabel}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Add"
                                    Margin="0,0,6,0" Padding="10,7"
                                    Command="{Binding DataContext.EmployeesVm.OpenAddEmployeeCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Cash PDF"
                                    Margin="0,0,6,0" Padding="10,7" Command="{Binding ExportCashPdfCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="All PDF"
                                    Margin="0,0,6,0" Padding="10,7" Command="{Binding ExportSummaryPdfCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="ICICI"
                                    Margin="0,0,6,0" Padding="10,7" Command="{Binding ExportIciciExcelCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Excel"
                                    Margin="0,0,6,0" Padding="10,7" Command="{Binding ExportToExcelCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Post Adv"
                                    Padding="10,7"
                                    Command="{Binding PostDeductionsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource EmptyStateTitle}"
                                   Text="No active employees for this period"/>
                        <TextBlock Style="{StaticResource EmptyStateSubtitle}"
                                   Text="Add employees from the Employees page, or pick a different month/group."/>
                    </StackPanel>

                    <DataGrid x:Name="SalaryGrid"
                              ItemsSource="{Binding RowsView}"
                              IsReadOnly="{Binding IsGridReadOnly}"
                              RowHeight="44"
                              RowBackground="White"
                              AlternatingRowBackground="#F3F4F6"
                              AlternationCount="2"
                              CanUserResizeColumns="True"
                              CellStyle="{StaticResource SalaryReadOnlyCell}"
                              ColumnHeaderStyle="{StaticResource ResizableSalaryColumnHeader}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SelectionUnit="Cell"
                              SelectionMode="Single"
                              CurrentCellChanged="SalaryGrid_CurrentCellChanged"
                              PreviewKeyDown="SalaryGrid_PreviewKeyDown">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <StackPanel>
                                                        <Border Background="#F8FAFC"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                Padding="12,9">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource TextBrush}"/>
                                                                <TextBlock HorizontalAlignment="Right"
                                                                           Text="{Binding Converter={StaticResource SalaryGroupSummaryConverter}}"
                                                                           FontSize="12"
                                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsPresenter/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#"
                                                helpers:DataGridColumnKey.Key="serial"
                                                Binding="{Binding SerialNumber}"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource SalaryHeaderCenter}"
                                                Width="44"
                                                MinWidth="44">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CenterCellText}">
                                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Employee" helpers:DataGridColumnKey.Key="employee" Width="*" MinWidth="250" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource SalaryHeaderLeft}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="96"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource LeftCellText}"
                                                       VerticalAlignment="Center"/>
                                            <CheckBox Grid.Column="1"
                                                      Content="Override"
                                                      IsChecked="{Binding IsBaseSalaryOverrideEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      Foreground="{StaticResource MutedTextBrush}"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0,6,0"/>
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding BaseSalaryOverride, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                     IsEnabled="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     ToolTip="{Binding BaseSalaryOverrideValidationMessage}"
                                                     TextAlignment="Right"
                                                     VerticalContentAlignment="Center"
                                                     Height="28"
                                                     Padding="6,0"
                                                     Visibility="{Binding IsBaseSalaryOverrideEnabled, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Group"
                                                helpers:DataGridColumnKey.Key="group"
                                                Binding="{Binding GroupDisplayName}"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource SalaryHeaderLeft}"
                                                ElementStyle="{StaticResource LeftCellText}"
                                                Width="90"
                                                MinWidth="82"/>

                            <DataGridTemplateColumn Header="Pay" helpers:DataGridColumnKey.Key="payment" Width="82" MinWidth="82" IsReadOnly="True"
                                                    HeaderStyle="{StaticResource SalaryHeaderCenter}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="12,4" HorizontalAlignment="Center" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="Cash">
                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PaymentMode}" Value="IciciBank">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                            <Setter Property="BorderBrush" Value="#93C5FD"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PaymentModeLabel}" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#047857"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaymentMode}" Value="Cash">
                                                                <Setter Property="Foreground" Value="#475569"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding PaymentMode}" Value="IciciBank">
                                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Base (₹)"
                                                helpers:DataGridColumnKey.Key="baseSalary"
                                                Binding="{Binding EffectiveBaseSalary, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                Width="110"
                                                MinWidth="104"
                                                ElementStyle="{StaticResource RightCellText}"/>

                            <DataGridTemplateColumn Header="Absent" helpers:DataGridColumnKey.Key="absent" Width="70"
                                                    MinWidth="64"
                                                    HeaderStyle="{StaticResource SalaryHeaderCenter}"
                                                    CellStyle="{StaticResource SalaryEditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DaysAbsent}"
                                                   Style="{StaticResource CenterCellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DaysAbsent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ESIC" helpers:DataGridColumnKey.Key="esic" Width="78"
                                                    MinWidth="70"
                                                    HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                    CellStyle="{StaticResource SalaryEditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EsicDeduction, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                   Style="{StaticResource RightCellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding EsicDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UsesEsicPf}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="PF" helpers:DataGridColumnKey.Key="pf" Width="74"
                                                    MinWidth="66"
                                                    HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                    CellStyle="{StaticResource SalaryEditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PfDeduction, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                   Style="{StaticResource RightCellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PfDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UsesEsicPf}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TDS" helpers:DataGridColumnKey.Key="tds" Width="78"
                                                    MinWidth="70"
                                                    HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                    CellStyle="{StaticResource SalaryEditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TdsDeduction, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                   Style="{StaticResource RightCellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding TdsDeduction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding UsesTds}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Deduct"
                                                helpers:DataGridColumnKey.Key="deductions"
                                                Binding="{Binding TotalDeductions, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                Width="96"
                                                MinWidth="86"
                                                ElementStyle="{StaticResource RightCellText}"/>

                            <DataGridTemplateColumn Header="Adv Ded" helpers:DataGridColumnKey.Key="advanceDeduction" Width="92"
                                                    MinWidth="86"
                                                    HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                    CellStyle="{StaticResource SalaryEditableCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AdvanceDeductionEntry, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                   Style="{StaticResource RightCellText}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding AdvanceDeductionEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 TextAlignment="Right"
                                                 VerticalContentAlignment="Center"
                                                 BorderThickness="0"
                                                 Padding="8,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Adv Bal"
                                                helpers:DataGridColumnKey.Key="advanceBalance"
                                                Binding="{Binding AdvanceBalance, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                IsReadOnly="True"
                                                HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                Width="98"
                                                MinWidth="86">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource RightCellText}">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#EA580C"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AdvanceBalance}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="Net" helpers:DataGridColumnKey.Key="netSalary" Width="106"
                                                    MinWidth="100"
                                                    IsReadOnly="True"
                                                    HeaderStyle="{StaticResource SalaryHeaderRight}"
                                                    CellStyle="{StaticResource SalaryReadOnlyCell}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding NetSalary, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=plain2}"
                                                   Style="{StaticResource RightCellText}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Margin="0,12,0,0"
                    CornerRadius="8"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    Background="White"
                    Padding="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="14,10">
                        <TextBlock Text="Gross Pay" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalGross, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=0}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="14,10">
                        <TextBlock Text="Absent Ded." Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAbsenceDeduction, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=2}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="14,10">
                        <TextBlock Text="ESIC" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalEsic, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=2}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="14,10">
                        <TextBlock Text="PF" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalPf, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=2}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" Margin="14,10">
                        <TextBlock Text="TDS" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalTds, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=2}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5" Margin="14,10">
                        <TextBlock Text="Adv. Deducted" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAdvanceDeduction, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=2}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Margin="14,10">
                        <TextBlock Text="Advance Balance" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalAdvanceBalance, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=2}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="7"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="0,8,8,0"
                            Padding="22,10">
                        <StackPanel>
                            <TextBlock Text="Net Payable" Foreground="#DBEAFE" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalNet, Converter={StaticResource IndianCurrencyConverter}, ConverterParameter=2}"
                                       Foreground="White"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
